; Engine configuration file.
config_version=5

[application]

config/name="Frogs in the Sky"
config/description="A chill voxel climbing game. Help frogs from around the world climb overgrown sky ruins to the crystal ponds."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Game="*res://scripts/game.gd"
Sfx="*res://scripts/sfx.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="props"

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=12

[rendering]

lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.82, 0.88, 0.9, 1)
anti_aliasing/quality/use_debanding=true
