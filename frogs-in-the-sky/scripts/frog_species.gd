static var _cache: Array = []

static func all() -> Array:
	if _cache.is_empty():
		for i in DATA.size():
			var parts: PackedStringArray = String(DATA[i]).split("|")
			_cache.append({
				"index": i,
				"name": parts[0],
				"region": parts[1],
				"base": Color(parts[2]),
				"accent": Color(parts[3]),
				"belly": Color(parts[4]),
				"pattern": parts[5],
				"eye": Color(parts[6]),
			})
	return _cache

static func get_species(i: int) -> Dictionary:
	var a := all()
	return a[clampi(i, 0, a.size() - 1)]

static func count() -> int:
	return DATA.size()
