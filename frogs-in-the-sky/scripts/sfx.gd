extends Node
## Sound manager. All sounds are generated by tools/gen_audio.py (soft, low-passed, no harsh highs).

const NAMES := [
	"music_pad", "amb_wind", "amb_water",
	"bird1", "bird2", "bird3", "crow1", "crow2",
	"croak1", "croak2", "croak3", "hop", "land", "plop", "splash", "snack", "tongue",
	"grow", "click", "stone", "valve", "water_rise", "seed", "solve", "complete",
	"ui_move", "ui_select", "whoosh", "flap", "step",
]

var streams := {}
var pool: Array[AudioStreamPlayer] = []
var pool3d: Array[AudioStreamPlayer3D] = []
var music: AudioStreamPlayer
var wind: AudioStreamPlayer
var water: AudioStreamPlayer
var ambient_on := false
var _amb_t := 5.0
var _p := 0
var _p3 := 0
var listener_pos := Vector3.ZERO


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	for n in NAMES:
		var path := "res://assets/audio/%s.wav" % n
		if ResourceLoader.exists(path):
			streams[n] = load(path)
	for i in 14:
		var p := AudioStreamPlayer.new()
		p.bus = "SFX"
		add_child(p)
		pool.append(p)
	for i in 18:
		var p := AudioStreamPlayer3D.new()
		p.bus = "SFX"
		p.unit_size = 7.0
		p.max_distance = 45.0
		p.attenuation_model = AudioStreamPlayer3D.ATTENUATION_INVERSE_DISTANCE
		p.attenuation_filter_cutoff_hz = 4000.0
		add_child(p)
		pool3d.append(p)
	music = _loop("music_pad", "Music", -4.0)
	wind = _loop("amb_wind", "Ambience", -8.0)
	water = _loop("amb_water", "Ambience", -40.0)


func _loop(n: String, bus: String, db: float) -> AudioStreamPlayer:
	var p := AudioStreamPlayer.new()
	p.bus = bus
	p.volume_db = db
	add_child(p)
	var s: Variant = streams.get(n)
	if s is AudioStreamWAV:
		var w: AudioStreamWAV = s
		w.loop_mode = AudioStreamWAV.LOOP_FORWARD
		w.loop_begin = 0
		w.loop_end = int(w.get_length() * w.mix_rate)
		p.stream = w
	return p


func start_ambience() -> void:
	ambient_on = true
	if music.stream and not music.playing:
		music.play()
	if wind.stream and not wind.playing:
		wind.play()
	if water.stream and not water.playing:
		water.play()


func set_water_proximity(k: float) -> void:
	if water:
		water.volume_db = lerpf(-40.0, -10.0, clampf(k, 0.0, 1.0))


func play(n: String, db: float = 0.0, pitch: float = 1.0, pitch_var: float = 0.06) -> void:
	if not streams.has(n):
		return
	var p := pool[_p]
	_p = (_p + 1) % pool.size()
	p.stream = streams[n]
	p.volume_db = db
	p.pitch_scale = pitch * randf_range(1.0 - pitch_var, 1.0 + pitch_var)
	p.play()


func play_at(n: String, pos: Vector3, db: float = 0.0, pitch: float = 1.0, pitch_var: float = 0.06) -> void:
	if not streams.has(n):
		return
	var p := pool3d[_p3]
	_p3 = (_p3 + 1) % pool3d.size()
	p.stream = streams[n]
	p.volume_db = db
	p.pitch_scale = pitch * randf_range(1.0 - pitch_var, 1.0 + pitch_var)
	p.global_position = pos
	p.play()


func _process(delta: float) -> void:
	if not ambient_on:
		return
	_amb_t -= delta
	if _amb_t <= 0.0:
		_amb_t = randf_range(5.0, 13.0)
		var off := Vector3(randf_range(-14, 14), randf_range(2, 8), randf_range(-14, 14))
		if randf() < 0.72:
			play_at("bird%d" % randi_range(1, 3), listener_pos + off, -14.0, 1.0, 0.1)
		else:
			play_at("crow%d" % randi_range(1, 2), listener_pos + off, -16.0, 1.0, 0.08)
